{
    "layer": "top",
    "spacing": 2,
    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/scratchpad", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["tray", "backlight", "network", "pulseaudio", "memory", "cpu", "hyprland/language", "battery", "clock", "custom/keyhelp"],
    // hyprctl を毎秒叩くポーリングをやめ、Hyprland のイベントで更新する
    "hyprland/language": {
        "format": "󰥻 {shortDescription}",
        "tooltip-format": "{long}"
    },
    // ショートカット早見表 (SUPER + / と同じもの)。キーを忘れてもここから開ける
    "custom/keyhelp": {
        "format": "󰌌",
        "tooltip-format": "ショートカット一覧 (SUPER + /)",
        "on-click": "pkill -f ~/.config/hypr/tools/keyhelp/keyhelp.sh || foot --title Keys ~/.config/hypr/tools/keyhelp/keyhelp.sh"
    },
    "hyprland/window": {
        "rewrite": {
            "(.*) — Mozilla Firefox": "Firefox",
        },
    },
    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "format-icons": ["", " "],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "tray": {
        "spacing": 10,
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "  {:%m/%d (%a) %H:%M}"
    },
    "cpu": {
        "format": " {usage:02}%"
    },
    "memory": {
        "format": " {percentage:02}%"
    },
    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰛩 ", "󱩎 ", "󱩏 ", "󱩐 ", "󱩑 ", "󱩒 ", "󱩓 ", "󱩔 ", "󱩕 ", "󱩖 ", "󰛨 "],
        "tooltip": true,
        "tooltip-format": "{percent}%",
        "scroll-step": 0.1
    },
    "battery": {
        "format": "{icon}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "{capacity}%",
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr} ethernet",
        "format-disconnected": "󰤮 ",
        "format-icons": ["󰤟 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "󰂰 ",
        "format-muted": "󰖁 ",
        "format-icons": {
            "headphones": "",
            "handsfree": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": " ",
            "default": [" ", " ", "󰕾 ", " "],
        },
        "on-click-right": "pavucontrol",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "reverse-scrolling": true,
        "tooltip": true,
        "tooltip-format": "{volume}%"
    }
}
